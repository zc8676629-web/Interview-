{
  "appId": "com.zc8676629.interviewplusplus",
  "productName": "Interview Plus Plus",
  "asar": true,
  "artifactName": "interview-plus-plus-setup-${version}.${ext}",
  "directories": {
    "output": "release"
  },
  "files": [
    "desktop/dist/**/*",
    "server/dist/**/*",
    "web/dist/**/*",
    "package.json",
    "!**/*.map"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Interview Plus Plus"
  }
}
