{
  "name": "interview-plus-plus",
  "productName": "Interview Plus Plus",
  "version": "0.1.0",
  "description": "本地优先的面试复盘与 AI 备战工作台",
  "private": true,
  "type": "module",
  "main": "desktop/dist/main.js",
  "scripts": {
    "test": "vitest run",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "tsc -p server/tsconfig.json",
    "build:desktop": "tsc -p desktop/tsconfig.json",
    "build": "npm run build:server && npm run build:desktop && npm run build:web",
    "dist:win": "npm run build && electron-builder --config build/electron-builder.win.json --publish never",
    "dist:mac": "npm run build && electron-builder --config build/electron-builder.mac.json --x64 --arm64 --publish never"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "mammoth": "^1.11.0",
    "multer": "^2.0.2",
    "pdf-parse": "^1.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^26.1.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
